{
  "name": "agridirect",
  "version": "0.1.0",
  "private": true,
  "description": "AgriDirect — Algerian multi-vendor agricultural marketplace (Du champ à votre table)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "db:verify:local": "tsx scripts/verify-schema-local.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/server/db/seed/index.ts",
    "db:verify": "tsx scripts/verify-empty.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:local": "tsx scripts/dev-postgres.ts",
    "check:images": "tsx scripts/check-images.ts",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "next-intl": "^4.15.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "algeria-geo": "^1.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
