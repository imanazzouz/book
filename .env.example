# ---------------------------------------------------------------------------
# AgriDirect — environment variable NAMES only. Never commit real values.
# Copy to `.env.local` (git-ignored) and fill in what the phase you run needs.
# ---------------------------------------------------------------------------

# Runtime
APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Neon PostgreSQL) — phase 3
# Pooled connection string from the Neon dashboard, e.g.
# postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Optional: pool size (default 5). Neon's free tier likes small pools.
DATABASE_POOL_MAX=5
# Optional: `auto` (default, TLS on), `disable` for the local `npm run db:local` server.
DATABASE_SSL=auto
# Optional: disposable Neon branch used by `npm run test:db`
TEST_DATABASE_URL=

# Admin bootstrap — phase 3 (`npm run admin:create`)
ADMIN_EMAIL=
ADMIN_NAME=

# Auth (Better Auth) — phase 4
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OTP_HASH_PEPPER=

# Email (Resend) — phase 4
RESEND_API_KEY=
EMAIL_FROM=

# Media (Vercel Blob) — phase 4
BLOB_READ_WRITE_TOKEN=

# Rate limiting (Upstash Redis) — phase 4, optional in development
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Observability — phase 7, optional
SENTRY_DSN=
