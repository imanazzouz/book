# ---------------------------------------------------------------------------
# AgriDirect — environment variable NAMES only. Never commit real values.
# Phase 2 needs none of these. They are wired in phases 3-7.
# ---------------------------------------------------------------------------

# Runtime
APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Neon PostgreSQL) — phase 3
DATABASE_URL=
DIRECT_URL=

# Auth (Better Auth) — phase 4
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OTP_HASH_PEPPER=

# Email (Resend) — phase 4
RESEND_API_KEY=
EMAIL_FROM=

# Media (Vercel Blob) — phase 4
BLOB_READ_WRITE_TOKEN=

# Rate limiting (Upstash Redis) — phase 4, optional in development
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Observability — phase 7, optional
SENTRY_DSN=
